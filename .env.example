# Скопируйте в .env и заполните значения.
# BOT_TOKEN — из @BotFather
# ID групп — числовой chat_id (например через @userinfobot или лог при первом сообщении в группе)

BOT_TOKEN=
# Один чат-источник (legacy вариант):
# Можно указать один id:
# SOURCE_GROUP_ID=-100123
# Или даже список через запятую (тоже поддерживается):
# SOURCE_GROUP_ID=-100123,-100456
SOURCE_GROUP_ID=
# Или несколько чатов-источников через запятую (приоритетнее SOURCE_GROUP_ID):
# SOURCE_GROUP_IDS=-100123,-100456
SOURCE_GROUP_IDS=
TARGET_GROUP_ID=

# --- Опционально: чтение из групп-источников через MTProto (Telethon) ---
# Нужно, чтобы видеть сообщения от других ботов в группе. PDF по-прежнему шлёт BOT_TOKEN-бот.
# api_id и api_hash: https://my.telegram.org/apps
# После первого входа появится файл TELEGRAM_SESSION_FILE (храните в секрете, как пароль).
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_FILE=telethon.session
# TELEGRAM_SESSION_STRING=
# TELEGRAM_PHONE=+79001234567
# TELEGRAM_2FA_PASSWORD=
# Первый вход по QR (если код по телефону неудобен; в Telegram: Устройства → Подключить устройство):
# TELEGRAM_LOGIN_QR=1
