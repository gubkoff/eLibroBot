# Скопируйте в .env и заполните значения.
# BOT_TOKEN — из @BotFather
# ID групп — числовой chat_id (например через @userinfobot или лог при первом сообщении в группе)
# Опционально: стоимость по категориям из Google Таблицы (колонки A=наименование, B=цена)
# SPREADSHEET_ID — ID таблицы из ссылки ( .../d/SPREADSHEET_ID/edit )
#   Для доступа без авторизации: в таблице Файл → Открыть доступ → Опубликовать в интернете → формат CSV.
# GOOGLE_CREDENTIALS_FILE — не обязателен для публичных таблиц; укажите путь к JSON ключу сервисного аккаунта для закрытых таблиц.

BOT_TOKEN=
SOURCE_GROUP_ID=
TARGET_GROUP_ID=
# Публичная таблица — достаточно SPREADSHEET_ID (таблица должна быть опубликована в веб как CSV)
# SPREADSHEET_ID=1AIxS1ue3F2lCioZM4odJdjoESkHPiLHawg_CRF8AMZg
# GOOGLE_CREDENTIALS_FILE=credentials.json
